# MusicForge environment variables.
# Copy to .env.local (loaded by `pnpm start` via --env-file-if-exists and by
# the Vite dev middleware) or export in your shell.
# Keys are used SERVER-SIDE ONLY — they are never bundled into the client JS.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (alias: CLAUDE_API_KEY)
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq
GROQ_API_KEY=

# OpenRouter (site attribution headers sent with OpenRouter calls)
OPENROUTER_API_KEY=
# OPENROUTER_SITE_URL=https://your-app.example.com
# OPENROUTER_SITE_NAME=Your App Name

# Gemini image generation for POST /api/generate-artwork
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Standalone server options
# PORT=3005
# CORS_ALLOW_ORIGIN=http://localhost:3005
# API_ACCESS_TOKEN=
