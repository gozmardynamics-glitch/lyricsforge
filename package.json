{
    "version": "0.0.0",
    "name": "ai-lyrics-generator",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --target=node20 --sourcemap",
        "build:all": "pnpm build && pnpm build:server",
        "preview": "vite preview",
        "start": "node --env-file-if-exists=.env.local dist-server/index.cjs",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/d3": "^7.4.3",
        "@types/node": "^22.14.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^5.0.0",
        "esbuild": "^0.28.2",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.8.2",
        "vite": "^6.2.0"
    },
    "type": "module",
    "dependencies": {
        "@google/genai": "^1.41.0",
        "d3": "^7.9.0",
        "jspdf": "^4.2.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "private": true
}
